#!/usr/bin/env bash
# Update Cat Cam on mina from the GitHub repo (the main branch holds the tested release).
#   catcam-update             install the newest version, if it is newer
#   catcam-update --check     show what is installed and what is available
#   catcam-update --previous  go back to the version that was installed before
set -euo pipefail
REPO="$HOME/catcam-repo"
SHARE="$HOME/.local/share/catcam"
[ "$(id -un)" = faure ] || { echo "Run as faure: catcam-update"; exit 1; }
[ -d "$REPO/.git" ] || { echo "The repo isn't cloned at $REPO yet. See the setup steps from Claude."; exit 1; }
cd "$REPO"
git fetch --quiet origin main
INSTALLED="$(cat "$SHARE/release/version" 2>/dev/null || echo none)"
AVAILABLE="$(git show origin/main:VERSION)"
case "${1:-}" in
  --check)
    echo "Installed: $INSTALLED"
    echo "Available: $AVAILABLE"
    git log --oneline -5 origin/main | sed 's/^/  /'
    exit 0 ;;
  --previous)
    TARGET="$(cat "$SHARE/rollback/commit" 2>/dev/null || true)"
    [ -n "$TARGET" ] || { echo "No earlier version is recorded to go back to."; exit 1; }
    git cat-file -e "$TARGET^{commit}" 2>/dev/null || git fetch --quiet origin "$TARGET"
    echo "Going back to $(git show "$TARGET:VERSION") ($TARGET)" ;;
  "")
    if [ "$AVAILABLE" = "$INSTALLED" ]; then
      # Still bring the repo up to date: the lounge installs from these files too.
      git -c advice.detachedHead=false checkout --quiet origin/main
      echo "Cat Cam $INSTALLED is up to date (lounge files refreshed)."; exit 0
    fi
    TARGET="$(git rev-parse origin/main)"
    echo "Installing Cat Cam $AVAILABLE (installed: $INSTALLED)"
    git log --format='  %s' -1 origin/main ;;
  *) sed -n '2,6p' "$0"; exit 1 ;;
esac
git -c advice.detachedHead=false checkout --quiet "$TARGET"
exec bash deploy/install.sh
